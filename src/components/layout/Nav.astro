---
import Icon from '../ui/Icon.astro';
---

<nav class="site-nav" aria-label="Main navigation">
	<div class="nav-inner wrapper">
		<a href="/" class="site-title" aria-label="irohamo home">
			<Icon icon="favicon" color="var(--accent-regular)" size="1.6em" gradient />
			<span>irohamo</span>
		</a>
		<ul class="nav-links">
			<li><a href="/works" aria-current={Astro.url.pathname.startsWith('/works') ? 'page' : undefined}>Works</a></li>
			<li><a href="/#about">About</a></li>
			<li><a href="/articles" aria-current={Astro.url.pathname.startsWith('/articles') ? 'page' : undefined}>Articles</a></li>
		</ul>
		<a class="contact-link" href="/#contact">Contact <span aria-hidden="true">↗</span></a>
	</div>
</nav>

<style>
	.site-nav {
		position: relative;
		z-index: 10;
		margin-bottom: 2rem;
		font-family: var(--font-brand);
	}

	.nav-inner {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.75rem 1rem;
		padding-block: 1.25rem;
	}

	.site-title {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		margin-right: auto;
		color: var(--gray-0);
		font-size: var(--text-lg);
		font-weight: 600;
		text-decoration: none;
	}

	.nav-links {
		order: 3;
		display: flex;
		flex: 1 0 100%;
		justify-content: space-between;
		gap: 0.5rem;
		margin: 0;
		padding: 0.75rem 0 0;
		border-top: 1px solid var(--gray-800);
		list-style: none;
	}

	.nav-links a,
	.contact-link {
		color: var(--gray-300);
		font-size: var(--text-sm);
		font-weight: 500;
		text-decoration: none;
		transition: color var(--theme-transition);
	}

	.nav-links a:hover,
	.nav-links a:focus-visible,
	.nav-links a[aria-current='page'],
	.contact-link:hover,
	.contact-link:focus-visible {
		color: var(--accent-dark);
	}

	.contact-link {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		border: 1px solid var(--gray-700);
		border-radius: 0.3rem;
		padding: 0.55rem 0.75rem;
		color: var(--gray-100);
	}

	@media (min-width: 50em) {
		.site-nav {
			margin-bottom: 2.5rem;
		}

		.nav-inner {
			flex-wrap: nowrap;
			gap: 2rem;
			padding-block: 2rem;
		}

		.nav-links {
			order: initial;
			flex: 0 1 auto;
			justify-content: flex-end;
			gap: 1.75rem;
			padding: 0;
			border: 0;
		}
	}
</style>
