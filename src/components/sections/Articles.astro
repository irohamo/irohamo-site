---
// Component Imports
import Grid from '../ui/Grid.astro';
import ArticlePreview from '../cards/ArticlePreview.astro';
import { getCollection } from 'astro:content';

const allArticles = (await getCollection('articles')).sort(
	(a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf(),
);

const articles = allArticles.slice(0, 3);
---

<section id="articles" class="section with-background">
	<header class="section-header stack gap-2 lg:gap-4">
		<p class="eyebrow">Writing</p>
		<h2>Articles</h2>
	</header>

	<div class="gallery">
		<Grid>
			{
				articles.map((article) => (
					<li>
						<ArticlePreview article={article} />
					</li>
				))
			}
		</Grid>
	</div>

	{
		allArticles.length > 3 && (
			<footer class="section-footer">
				<a href="/articles" class="section-link">
					すべて見る<span aria-hidden="true">→</span>
				</a>
			</footer>
		)
	}
</section>

<style>
	.section-header h2 {
		color: var(--gray-0);
		font-size: var(--text-2xl);
	}

	.section-footer {
		display: flex;
		justify-content: flex-end;
		margin-top: 1.25rem;
	}

	.section-link {
		display: inline-flex;
		align-items: center;
		gap: 0.4em;
		padding: 0.25rem 0;
		color: var(--gray-0);
		font-family: var(--font-brand);
		font-size: var(--text-sm);
		font-weight: 500;
		letter-spacing: 0.02em;
		text-decoration: none;
		border-bottom: 1px solid var(--gray-300);
		transition:
			color var(--theme-transition),
			border-color var(--theme-transition);
	}

	.section-link span {
		transition: transform var(--theme-transition);
	}

	.section-link:hover,
	.section-link:focus-visible {
		color: var(--accent-regular);
		border-color: var(--accent-regular);
	}

	.section-link:hover span,
	.section-link:focus-visible span {
		transform: translateX(3px);
	}

	@media (min-width: 50em) {
		.section-header h2 {
			font-size: var(--text-4xl);
		}
	}
</style>
