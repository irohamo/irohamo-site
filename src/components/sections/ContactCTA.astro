---
import CallToAction from '../ui/CallToAction.astro';
import Icon from '../ui/Icon.astro';
---

<section id="contact" class="contact">
	<div class="contact-inner wrapper">
		<div class="copy stack gap-2">
			<p class="eyebrow">Get in touch</p>
			<h2>Contact</h2>
			<p>
				採用・仕事のご相談、その他のお問い合わせは、メールでご連絡ください。
				お仕事のご相談の際は、<a href="/work#inquiry">こちら</a>に記載の項目を添えていただけると助かります。
			</p>
		</div>

		<div class="actions">
			<CallToAction href="mailto:irohamo@irohamo.dev">
				Send an Email
				<Icon icon="paper-plane-tilt" size="1.2em" />
			</CallToAction>
			<div class="socials" aria-label="Social links">
				<a href="https://github.com/IrohaMo" target="_blank" rel="noopener noreferrer">
					<Icon icon="github-logo" size="1.25em" />
					<span>GitHub</span>
				</a>
				<a href="https://Instagram.com/irohamo.dev" target="_blank" rel="noopener noreferrer">
					<Icon icon="instagram-logo" size="1.25em" />
					<span>Instagram</span>
				</a>
			</div>
		</div>
	</div>
</section>

<style>
	.contact {
		border-top: 1px solid var(--gray-800);
		border-bottom: 1px solid var(--gray-800);
		background:
			linear-gradient(180deg, transparent, var(--gray-999_40)),
			var(--gray-999_40);
		box-shadow: var(--shadow-sm);
	}

	.contact-inner {
		display: grid;
		gap: 1.5rem;
		padding-block: 2.5rem;
	}

	.copy {
		max-width: 42rem;
	}

	h2 {
		color: var(--gray-0);
		font-size: var(--text-xl);
	}

	p {
		color: var(--gray-0);
		font-size: var(--text-base);
	}

	.actions {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 1.5rem;
	}

	.socials {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 0.75rem;
	}

	.socials a {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		border: 1px solid var(--gray-800);
		border-radius: 0.375rem;
		padding: 0.65rem 1rem;
		background-color: transparent;
		color: var(--gray-200);
		font-family: var(--font-brand);
		font-size: var(--text-sm);
		font-weight: 500;
		text-decoration: none;
		transition:
			border-color var(--theme-transition),
			color var(--theme-transition);
	}

	.socials a:hover,
	.socials a:focus {
		border-color: var(--gray-600);
		color: var(--gray-0);
	}

	@media (min-width: 50em) {
		.contact-inner {
			grid-template-columns: minmax(0, 1fr) auto;
			align-items: center;
			padding-block: 3.5rem;
		}

		h2 {
			font-size: var(--text-2xl);
		}

		p {
			font-size: var(--text-md);
		}

		.actions {
			align-items: center;
		}
	}
</style>
