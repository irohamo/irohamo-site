---
import ContactCTA from '../components/sections/ContactCTA.astro';
import Hero from '../components/sections/Hero.astro';
import Icon from '../components/ui/Icon.astro';
import About from '../components/sections/About.astro';
import Works from '../components/sections/Works.astro';
import Articles from '../components/sections/Articles.astro';
import BaseLayout from '../layouts/BaseLayout.astro';

import type { iconPaths } from '../components/ui/IconPaths';

const iconLinks: { label: string; href: string; icon: keyof typeof iconPaths }[] = [
	{ label: 'GitHub', href: 'https://github.com/IrohaMo', icon: 'github-logo' },
	{ label: 'X', href: 'https://x.com/irohamo_dev', icon: 'twitter-logo' },
	{ label: 'Instagram', href: 'https://instagram.com/irohamo.dev', icon: 'instagram-logo' },
];
---

<BaseLayout
	title="Shu Kawakami | irohamo"
	description="ソフトウェア開発と津軽三味線。ShamiScoreやアプリ、Web、ハードウェアのプロジェクトを紹介します。"
>
	<div class="stack gap-15 lg:gap-20">
		<main class="stack gap-15 lg:gap-20">
			<div class="wrapper stack gap-8 lg:gap-15">
				<header class="hero">
					<Hero
						title="Shu Kawakami"
						align="start"
					>
						<p class="intro-copy">
							三味線奏者向け譜面アプリ「ShamiScore」の個人開発や、チームでのアプリ・ハードウェア開発に取り組んでいます。
						</p>
						<div class="socials" aria-label="ソーシャルリンク">
							{iconLinks.map(({ href, icon, label }) => (
								<a href={href} class="social" target="_blank" rel="noopener noreferrer">
									<span class="sr-only">{label}</span>
									<Icon icon={icon} />
								</a>
							))}
						</div>
					</Hero>
				</header>
				<Works />
			</div>

			<About />

			<div class="wrapper">
				<Articles />
			</div>
		</main>
		<ContactCTA />
	</div>
</BaseLayout>

<style>
	.hero {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
	}

	.intro-copy {
		max-width: 52ch;
		color: var(--gray-200);
		font-family: var(--font-body);
		font-size: var(--text-md);
		line-height: 1.75;
	}

	.socials {
		display: flex;
		gap: 0.25rem;
		margin-inline: -0.5rem;
	}

	.social {
		display: flex;
		padding: 0.5rem;
		color: var(--gray-400);
		text-decoration: none;
		transition: color var(--theme-transition);
	}

	.social:hover,
	.social:focus-visible {
		color: var(--gray-0);
	}

	@media (min-width: 50em) {
		.hero {
			padding-inline: 2.5rem;
		}
	}
</style>
